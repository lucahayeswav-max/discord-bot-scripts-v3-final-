-- Robust Teleport Function
local function Teleport(CF)
    local ch = LP.Character
    if ch and ch:FindFirstChild("HumanoidRootPart") then
        local hrp = ch.HumanoidRootPart
        hrp.Anchored = true
        hrp.CFrame = CF
        task.wait(0.1)
        hrp.Anchored = false
    end
end

