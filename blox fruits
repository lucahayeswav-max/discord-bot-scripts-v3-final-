task.spawn(function()
    while task.wait(2) do
        if States.AutoQuests then
            local ch=LP.Character
            if ch and ch:FindFirstChild("HumanoidRootPart") then
                local cl,dist=nil,math.huge
                for _,v in pairs(workspace:GetChildren()) do
                    if v:IsA("Model") and v:FindFirstChild("HumanoidRootPart") then
                        -- Check exact name or name with trailing space
                        local cleanName = string.gsub(v.Name, "%s+$", "")
                        if Quests[cleanName] then
                            local d=(ch.HumanoidRootPart.Position-v.HumanoidRootPart.Position).Magnitude
                            if d<dist then dist=d;cl=v end
                        end
                    end
                end
                if cl then
                    FlyTo(cl.HumanoidRootPart.CFrame*CFrame.new(0,0,3))
                    task.wait(0.5)
                    pcall(function() ReplicatedStorage.Remotes.CommF_:InvokeServer("StartQuest",cl.Name) end)
                    task.wait(1.5)
                end
            end
        end
    end
end)

RunService.Heartbeat:Connect(function()
    if not States.AutoFarm then return end
    local ch=LP.Character
    if not ch or not ch:FindFirstChild("HumanoidRootPart") then return end
    local cl,dist=nil,math.huge
    local en=workspace:FindFirstChild("Enemies")
    if en then
        for _,v in pairs(en:GetChildren()) do
            if v:FindFirstChild("HumanoidRootPart") and v:FindFirstChild("Humanoid") and v.Humanoid.Health>0 then
                local d=(ch.HumanoidRootPart.Position-v.HumanoidRootPart.Position).Magnitude
                if d<dist and d<=Config.FarmRange then dist=d;cl=v end
            end
        end
    end
    if cl and dist>5 then FlyTo(cl.HumanoidRootPart.CFrame*CFrame.new(0,0,3)) end
end)
