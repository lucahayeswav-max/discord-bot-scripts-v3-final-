local function FlyTo(CF)
    local ch=LP.Character
    if not ch or not ch:FindFirstChild("HumanoidRootPart") then return end
    local hrp=ch.HumanoidRootPart
    FlyToken=FlyToken+1
    local myToken=FlyToken
    if currentTween then currentTween:Cancel() end
    local tweenInfo=TweenInfo.new(2.5,Enum.EasingStyle.Linear)
    currentTween=TweenService:Create(hrp,tweenInfo,{CFrame=CF})
    currentTween:Play()
    local conn
    conn=currentTween.Completed:Connect(function() if myToken==FlyToken then currentTween=nil end conn:Disconnect() end)
end
