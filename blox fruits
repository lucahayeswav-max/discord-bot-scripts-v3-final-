    l.TextXAlignment=Enum.TextXAlignment.Left
    local s=Instance.new("TextButton",f)
    s.Size=UDim2.new(0,30,0,16)
    s.Position=UDim2.new(1,-40,0.5,-8)
    s.BackgroundColor3=def and Theme.Accent or Theme.ToggleOff
    s.Text=""
    s.AutoButtonColor=false
    Instance.new("UICorner",s).CornerRadius=UDim.new(1,0)
    local c=Instance.new("Frame",s)
    c.Size=UDim2.new(0,12,0,12)
    c.Position=def and UDim2.new(1,-14,0.5,-6) or UDim2.new(0,2,0.5,-6)
    c.BackgroundColor3=Theme.Text
    Instance.new("UICorner",c).CornerRadius=UDim.new(1,0)
    local st=def
    s.MouseButton1Click:Connect(function()
        st=not st
        TweenService:Create(s,TweenInfo.new(0.2),{BackgroundColor3=st and Theme.Accent or Theme.ToggleOff}):Play()
        TweenService:Create(c,TweenInfo.new(0.2),{Position=st and UDim2.new(1,-14,0.5,-6) or UDim2.new(0,2,0.5,-6)}):Play()
        cb(st)
    end)
end

local function MakeSlider(parent,text,y,min,max,def,cb)
    local f=Instance.new("Frame",parent)
    f.Size=UDim2.new(1,-20,0,45)
    f.Position=UDim2.new(0,5,0,y)
    f.BackgroundColor3=Theme.PanelBg
    Instance.new("UICorner",f).CornerRadius=UDim.new(0,4)
    local l=Instance.new("TextLabel",f)
    l.Size=UDim2.new(1,-20,0,15)
    l.Position=UDim2.new(0,10,0,5)
    l.BackgroundTransparency=1
    l.Text=text..": "..def
    l.TextColor3=Theme.Text
    l.Font=Enum.Font.Gotham
    l.TextSize=11
    l.TextXAlignment=Enum.TextXAlignment.Left
    local bg=Instance.new("Frame",f)
    bg.Size=UDim2.new(1,-20,0,6)
    bg.Position=UDim2.new(0,10,0,28)
    bg.BackgroundColor3=Theme.ToggleOff
    Instance.new("UICorner",bg).CornerRadius=UDim.new(1,0)
    local fill=Instance.new("Frame",bg)
    fill.Size=UDim2.new((def-min)/(max-min),0,1,0)
    fill.BackgroundColor3=Theme.Accent
    Instance.new("UICorner",fill).CornerRadius=UDim.new(1,0)
    local knob=Instance.new("Frame",bg)
    knob.Size=UDim2.new(0,12,0,12)
    knob.Position=UDim2.new((def-min)/(max-min),-6,0.5,-6)
    knob.BackgroundColor3=Theme.Text
    Instance.new("UICorner",knob).CornerRadius=UDim.new(1,0)
    local dr=false
    local function upd(input)
        local p=math.clamp((input.Position.X-bg.AbsolutePosition.X)/bg.AbsoluteSize.X,0,1)
        fill.Size=UDim2.new(p,0,1,0)
        knob.Position=UDim2.new(p,-6,0.5,-6)
        local v=math.floor(min+(p*(max-min)))
        l.Text=text..": "..v
        cb(v)
    end
    bg.InputBegan:Connect(function(input)
        if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then dr=true;upd(input) end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dr and (input.UserInputType==Enum.UserInputType.MouseMovement or input.UserInputType==Enum.UserInputType.Touch) then upd(input) end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then dr=false end
    end)
end

