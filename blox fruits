    Instance.new("UICorner",switch).CornerRadius=UDim.new(0,20)
    local dot=Instance.new("Frame",switch)
    dot.Position=enabled and UDim2.new(1,-18,0,2) or UDim2.fromOffset(2,2)
    dot.Size=UDim2.fromOffset(16,16)
    dot.BackgroundColor3=Color3.new(1,1,1)
    Instance.new("UICorner",dot).CornerRadius=UDim.new(0,20)
    switch.MouseButton1Click:Connect(function()
        enabled=not enabled
        TweenService:Create(switch,TweenInfo.new(0.15),{BackgroundColor3=enabled and Theme.Accent or Theme.Off}):Play()
        TweenService:Create(dot,TweenInfo.new(0.15),{Position=enabled and UDim2.new(1,-18,0,2) or UDim2.fromOffset(2,2)}):Play()
        callback(enabled)
    end)
end

local function FlyTo(TargetCF)
    local ch=LP.Character
    if not ch or not ch:FindFirstChild("HumanoidRootPart") then return end
    local hrp=ch.HumanoidRootPart
    local bv=Instance.new("BodyVelocity")
    bv.MaxForce=Vector3.new(math.huge,math.huge,math.huge)
    bv.Parent=hrp
    local startPos=hrp.Position
    local endPos=TargetCF.Position
    local distance=(endPos-startPos).Magnitude
    local speed=distance/1.5
    bv.Velocity=(endPos-startPos).Unit*speed
    task.wait(1.5)
    if bv then bv:Destroy() end
    hrp.CFrame=TargetCF
end

