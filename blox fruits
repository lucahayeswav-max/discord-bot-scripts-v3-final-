    bg.Position=UDim2.fromOffset(10,28)
    bg.BackgroundColor3=Theme.Off
    Instance.new("UICorner",bg).CornerRadius=UDim.new(1,0)
    local fill=Instance.new("Frame",bg)
    fill.Size=UDim2.new((def-min)/(max-min),0,1,0)
    fill.BackgroundColor3=Theme.Accent
    Instance.new("UICorner",fill).CornerRadius=UDim.new(1,0)
    local knob=Instance.new("Frame",bg)
    knob.Size=UDim2.fromOffset(12,12)
    knob.Position=UDim2.new((def-min)/(max-min),-6,0.5,-6)
    knob.BackgroundColor3=Theme.Text
    Instance.new("UICorner",knob).CornerRadius=UDim.new(1,0)
    local dr=false
    local function upd(input)
        local p=math.clamp((input.Position.X-bg.AbsolutePosition.X)/bg.AbsoluteSize.X,0,1)
        fill.Size=UDim2.new(p,0,1,0)
        knob.Position=UDim2.new(p,-6,0.5,-6)
        local v=math.floor(min+(p*(max-min)))
        l.Text=text..": "..v
        cb(v)
    end
    AddConn(bg.InputBegan:Connect(function(input) if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then dr=true;upd(input) end end))
    AddConn(UserInputService.InputChanged:Connect(function(input) if dr and (input.UserInputType==Enum.UserInputType.MouseMovement or input.UserInputType==Enum.UserInputType.Touch) then upd(input) end end))
    AddConn(UserInputService.InputEnded:Connect(function(input) if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then dr=false end end))
