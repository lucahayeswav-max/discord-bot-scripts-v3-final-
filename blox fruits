task.spawn(function()
    while task.wait(2) do
        if States.AutoQuests then
            local ch=LP.Character
            if ch and ch:FindFirstChild("HumanoidRootPart") then
                local closestNPC, shortDist = nil, math.huge
                for _, v in pairs(workspace:GetChildren()) do
                    if v:IsA("Model") and QuestNPCs[v.Name] then
                        if v:FindFirstChild("HumanoidRootPart") then
                            local d = (ch.HumanoidRootPart.Position - v.HumanoidRootPart.Position).Magnitude
                            if d < shortDist then shortDist = d; closestNPC = v end
                        end
                    end
                end
                if closestNPC then
                    Teleport(closestNPC.HumanoidRootPart.CFrame * CFrame.new(0,0,3))
                    task.wait(0.5)
                    local questId = QuestNPCs[closestNPC.Name]
                    local args = {[1] = "StartQuest", [2] = closestNPC.Name, [3] = questId}
                    pcall(function() ReplicatedStorage.Remotes.CommF_:InvokeServer(unpack(args)) end)
                    task.wait(2)
                end
            end
        end
    end
end)

RunService.Heartbeat:Connect(function()
    if not States.AutoFarm then return end
    local ch=LP.Character
    if not ch or not ch:FindFirstChild("HumanoidRootPart") then return end
    local closest,shortest=nil,math.huge
    local en=workspace:FindFirstChild("Enemies")
    if en then
        for _,v in pairs(en:GetChildren()) do
            if v:FindFirstChild("HumanoidRootPart") and v:FindFirstChild("Humanoid") and v.Humanoid.Health>0 then
                local d=(ch.HumanoidRootPart.Position-v.HumanoidRootPart.Position).Magnitude
                if d<shortest and d<=Config.FarmRange then shortest=d;closest=v end
            end
        end
    end
    if closest then
        if shortest>5 then Teleport(closest.HumanoidRootPart.CFrame*CFrame.new(0,0,3)) end
    end
end)
