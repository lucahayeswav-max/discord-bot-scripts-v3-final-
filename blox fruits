local function MakeToggle(parent,text,y,def,cb)
    local f=Instance.new("Frame",parent)
    f.Size=UDim2.new(1,-10,0,35)
    f.Position=UDim2.new(0,5,0,y)
    f.BackgroundColor3=Theme.PanelBg
    Instance.new("UICorner",f).CornerRadius=UDim.new(0,4)
    local l=Instance.new("TextLabel",f)
    l.Size=UDim2.new(1,-60,1,0)
    l.Position=UDim2.new(0,10,0,0)
    l.BackgroundTransparency=1
    l.Text=text
    l.TextColor3=Theme.Text
    l.Font=Enum.Font.Gotham
    l.TextSize=12
    l.TextXAlignment=Enum.TextXAlignment.Left
    local s=Instance.new("TextButton",f)
    s.Size=UDim2.new(0,30,0,16)
    s.Position=UDim2.new(1,-40,0.5,-8)
    s.BackgroundColor3=def and Theme.Accent or Theme.ToggleOff
    s.Text=""
    s.AutoButtonColor=false
    Instance.new("UICorner",s).CornerRadius=UDim.new(1,0)
    local c=Instance.new("Frame",s)
    c.Size=UDim2.new(0,12,0,12)
    c.Position=def and UDim2.new(1,-14,0.5,-6) or UDim2.new(0,2,0.5,-6)
    c.BackgroundColor3=Theme.Text
    Instance.new("UICorner",c).CornerRadius=UDim.new(1,0)
    local st=def
    s.MouseButton1Click:Connect(function()
        st=not st
        TweenService:Create(s,TweenInfo.new(0.15),{BackgroundColor3=st and Theme.Accent or Theme.ToggleOff}):Play()
        TweenService:Create(c,TweenInfo.new(0.15),{Position=st and UDim2.new(1,-14,0.5,-6) or UDim2.new(0,2,0.5,-6)}):Play()
        cb(st)
    end)
end

