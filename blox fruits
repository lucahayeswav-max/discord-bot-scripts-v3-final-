        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        AutoButtonColor = false
    })
    corner(button, 8)

    button.MouseEnter:Connect(function()
        TweenService:Create(button, TweenInfo.new(0.15), { BackgroundColor3 = Theme.Accent }):Play()
    end)

    button.MouseLeave:Connect(function()
        TweenService:Create(button, TweenInfo.new(0.15), { BackgroundColor3 = Theme.Panel }):Play()
    end)

    button.MouseButton1Click:Connect(callback)
    return button
end

local function toggle(parent, title, default, callback)
    local row = make("Frame", parent, {
        Size = UDim2.new(1, -8, 0, 42),
        BackgroundColor3 = Theme.Panel,
        BorderSizePixel = 0
    })
    corner(row, 8)

    make("TextLabel", row, {
        Position = UDim2.fromOffset(12, 0),
        Size = UDim2.new(1, -65, 1, 0),
        BackgroundTransparency = 1,
        Text = title,
        TextColor3 = Theme.Text,
        Font = Enum.Font.Gotham,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left
    })

    local enabled = default == true

    local switch = make("TextButton", row, {
        Position = UDim2.new(1, -48, 0.5, -10),
        Size = UDim2.fromOffset(36, 20),
        BackgroundColor3 = enabled and Theme.Accent or Theme.Off,
        Text = "",
        AutoButtonColor = false
    })
    corner(switch, 20)

    local dot = make("Frame", switch, {
        Position = enabled and UDim2.new(1, -18, 0, 2) or UDim2.fromOffset(2, 2),
        Size = UDim2.fromOffset(16, 16),
        BackgroundColor3 = Color3.new(1, 1, 1)
    })
    corner(dot, 20)

    switch.MouseButton1Click:Connect(function()
        enabled = not enabled
        TweenService:Create(switch, TweenInfo.new(0.15), { BackgroundColor3 = enabled and Theme.Accent or Theme.Off }):Play()
        TweenService:Create(dot, TweenInfo.new(0.15), { Position = enabled and UDim2.new(1, -18, 0, 2) or UDim2.fromOffset(2, 2) }):Play()
        callback(enabled)
    end)
end

